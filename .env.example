# Every variable Stakeout reads, its default and what it does. Do not copy this file whole: .env next to compose.yaml
# (never committed) holds only what differs from the defaults, PUBLIC_FQDN and a sign-in method at least (README,
# "Running it"); copy a line from here into it to change that setting. The container gets all of .env.

# Hostname Traefik routes Stakeout on (compose.yaml Host rule), no scheme, no port, e.g. stakeout.example.com. Required:
# left empty, every compose command stops and says so. The collector answers under /api, the dashboard under
# /dashboard on this host. It also makes cookies Secure and is the default OIDC redirect host.
PUBLIC_FQDN=

# Listen address inside the container. The Traefik service port in compose.yaml is 8080: change both together.
BACKEND_ADDR=:8080

# Proxies in front of Stakeout, each appending the caller's address to X-Forwarded-For: 1 for compose.yaml's Traefik.
# 0 when nothing proxies (a published port, a local run): the connection's address is the caller, the header is
# ignored. Every client address is read this way: the stored events, the collector's and sign-in's rate limits, the
# access log. Too high a count lets callers name their own address; an entry that is no address counts as missing.
BACKEND_TRUSTED_HOPS=1

# The container's volume (compose.yaml bind-mounts ./data here): app.db, ref/ (the ipverse data cache), sites.json,
# session.secret.
BACKEND_DATA_DIR=/data

# debug | info | warn | error
BACKEND_LOG_LEVEL=info

# --- Sites -------------------------------------------------------------------------------------------------------
# The sites Stakeout collects for, their feed key hashes and path rules (JSON). Empty: <BACKEND_DATA_DIR>/sites.json,
# which with compose is ./data/sites.json next to this file: copy docs/sites.example.json from the repo there and list
# your domains (README, Sites). Without the file Stakeout starts, logs "Sites file missing" and refuses every event.
# Read at start: restart after a change.
BACKEND_SITES_FILE=

# --- Storage -----------------------------------------------------------------------------------------------------
# Days raw events are kept: every request with its address, user agent and path; the log, a visitor's trail and
# "What it does" reach back this far. At least 15 (7d and its prior period are read raw), at most the months below.
# A day's raw goes only once its figures are built from it; a release that first purges deletes nothing for 7 days
# after its first start (the footer says from when).
BACKEND_RAW_RETENTION_DAYS=90
# Months each address's daily sums (visitors, refusals), the actor classes and the model's usage are kept. The
# figures (tiles, lists, hours) stay, comparison years included, unless the cap below takes them.
BACKEND_RETENTION_MONTHS=25
# Cap in MiB on what the rows take, checked every 5 minutes; past it the oldest go first until nine tenths remain:
# raw events (a day's figures built first; never the last three days), then the per-address sums, the lists, the
# hours. 0: no cap.
BACKEND_MAX_DB_MB=20480

# --- Dashboard sign-in (OIDC, e.g. Authelia, and/or an admin token) ----------------------------------------------
# With PUBLIC_FQDN set, Stakeout refuses to start without OIDC or BACKEND_ADMIN_TOKEN.
# Keys the session cookie's signature, with BACKEND_ADMIN_TOKEN: 32+ characters (openssl rand -hex 32). Empty: Stakeout
# makes one at first start and keeps it in <BACKEND_DATA_DIR>/session.secret (owner-only; the directory must be
# writable, or Stakeout refuses to start). Changing it, or deleting that file, signs everyone out.
BACKEND_SESSION_SECRET=
# Sign-in with a token instead of, or beside, OIDC (the way in when the provider is down): 32 to 2048 bytes
# (openssl rand -hex 32). Changing it signs everyone out, OIDC sessions included. Empty: no token sign-in.
BACKEND_ADMIN_TOKEN=
# All four or none. Without them and without BACKEND_ADMIN_TOKEN the dashboard answers 401 (the collector works
# regardless).
BACKEND_OIDC_ISSUER=
BACKEND_OIDC_CLIENT_ID=
BACKEND_OIDC_CLIENT_SECRET=
# Empty: https://<PUBLIC_FQDN>/api/auth/callback, which the provider must list as the client's redirect URI.
BACKEND_OIDC_REDIRECT_URL=
# The group a user must be in; empty admits every signed-in user.
BACKEND_OIDC_ADMIN_GROUP=
# Local development only: the dashboard without sign-in. Refused at start when PUBLIC_FQDN is set.
BACKEND_AUTH_DISABLED=false

# --- Reference data ----------------------------------------------------------------------------------------------
# true skips the daily download of ipverse's bot list, AS and country data (offline development); the cache in
# <BACKEND_DATA_DIR>/ref is still loaded.
BACKEND_REFDATA_DISABLED=false

# --- Model (llmwire) ---------------------------------------------------------------------------------------------
# Everything works without it: no key, no generated text, every figure stays.
# The llmwire profile the briefings, readings and labels use.
BACKEND_LLM_MODEL=mimo-v2.6-flash
# Daily budget per site: model calls and tokens (input plus output). The footer shows the day's calls. A fifth is
# kept for the briefing: readings and labels stop before it.
BACKEND_LLM_DAILY_CALLS=200
BACKEND_LLM_DAILY_TOKENS=400000
# llmwire's own variable for the profile's provider (mimo: the Token Plan host is llmwire's, only the key is set).
LLMWIRE_MIMO_API_KEY=
# Optional, llmwire's: route the model through a LiteLLM gateway instead (https, a bare root).
# LLMWIRE_LITELLM_BASE_URL=
# LLMWIRE_LITELLM_API_KEY=
# LLMWIRE_LITELLM_MODELS=mimo-v2.6-flash
