# Copy to .env next to compose.yaml (never committed). The container gets all of it.

# Hostname Traefik routes nui on (compose.yaml Host rule), no scheme, no port, e.g. nui.example.com. Required:
# left empty, every compose command stops and says so. The collector answers under /api, the dashboard under
# /dashboard on this host. It also makes cookies Secure and is the default OIDC redirect host.
PUBLIC_FQDN=

# Listen address inside the container. The Traefik service port in compose.yaml is 8080: change both together.
BACKEND_ADDR=:8080

# The container's volume (compose.yaml bind-mounts ./data here): nui.db, ref/ (the ipverse data cache), sites.json.
BACKEND_DATA_DIR=/data

# debug | info | warn | error
BACKEND_LOG_LEVEL=info

# --- Sites -------------------------------------------------------------------------------------------------------
# The sites nui collects for, their feed key hashes and path rules (JSON). Empty: <BACKEND_DATA_DIR>/sites.json, which
# with compose is ./data/sites.json next to this file: copy docs/sites.example.json from the repo there and list your
# domains (README, Sites). Without the file nui starts, logs "Sites file missing" and refuses every event. Read at
# start: restart after a change.
BACKEND_SITES_FILE=

# --- Storage -----------------------------------------------------------------------------------------------------
# Months raw events are kept. 25, so the 12-month view still has a whole comparison year.
BACKEND_RETENTION_MONTHS=25
# Cap in MiB on what the rows take, checked every 5 minutes; past it the oldest events go first until nine tenths
# remain (the yearly comparison then shortens). 0: no cap.
BACKEND_MAX_DB_MB=20480

# --- Dashboard sign-in (OIDC, e.g. Authelia, and/or an admin token) ----------------------------------------------
# With PUBLIC_FQDN set, nui refuses to start without OIDC or BACKEND_ADMIN_TOKEN.
# Signs the session cookie: 32+ characters (openssl rand -hex 32). Empty: derived from BACKEND_ADMIN_TOKEN, or
# without one a random key per start (everyone is signed out on restart).
BACKEND_SESSION_SECRET=
# Sign-in with a token instead of, or beside, OIDC (the way in when the provider is down): 32 to 2048 bytes
# (openssl rand -hex 32). Changing it signs everyone out, OIDC sessions included. Empty: no token sign-in.
BACKEND_ADMIN_TOKEN=
# All four or none. Without them and without BACKEND_ADMIN_TOKEN the dashboard answers 401 (the collector works
# regardless).
BACKEND_OIDC_ISSUER=
BACKEND_OIDC_CLIENT_ID=
BACKEND_OIDC_CLIENT_SECRET=
# Empty: https://<PUBLIC_FQDN>/api/auth/callback, which the provider must list as the client's redirect URI.
BACKEND_OIDC_REDIRECT_URL=
# The group a user must be in; empty admits every signed-in user.
BACKEND_OIDC_ADMIN_GROUP=
# Local development only: the dashboard without sign-in. Refused at start when PUBLIC_FQDN is set.
BACKEND_AUTH_DISABLED=false

# --- Reference data ----------------------------------------------------------------------------------------------
# true skips the daily download of ipverse's bot list, AS and country data (offline development); the cache in
# <BACKEND_DATA_DIR>/ref is still loaded.
BACKEND_REFDATA_DISABLED=false

# --- Model (llmwire) ---------------------------------------------------------------------------------------------
# Everything works without it: no key, no generated text, every figure stays.
# The llmwire profile the briefings, readings and labels use.
BACKEND_LLM_MODEL=mimo-v2.6-flash
# Daily budget per site: model calls and tokens (input plus output). The footer shows the day's calls. A fifth is
# kept for the briefing: readings and labels stop before it.
BACKEND_LLM_DAILY_CALLS=200
BACKEND_LLM_DAILY_TOKENS=400000
# llmwire's own variable for the profile's provider (mimo: the Token Plan host is llmwire's, only the key is set).
LLMWIRE_MIMO_API_KEY=
# Optional, llmwire's: route the model through a LiteLLM gateway instead (https, a bare root).
# LLMWIRE_LITELLM_BASE_URL=
# LLMWIRE_LITELLM_API_KEY=
# LLMWIRE_LITELLM_MODELS=mimo-v2.6-flash
