# Copy to .env next to compose.yaml (never committed). The container gets all of it.

# Hostname Traefik routes nui on (compose.yaml Host rule), no scheme, no port, e.g. nui.example.com. Required:
# left empty, every compose command stops and says so. The collector answers under /api, the dashboard under
# /dashboard on this host.
PUBLIC_FQDN=

# Listen address inside the container. The Traefik service port in compose.yaml is 8080: change both together.
BACKEND_ADDR=:8080

# The container's volume (compose.yaml bind-mounts ./data here).
BACKEND_DATA_DIR=/data

# debug | info | warn | error
BACKEND_LOG_LEVEL=info
